{
	"name": "@mirite/eslint-config-mirite",
	"version": "2.1.2",
	"description": "A collection of my favourite eslint rules for TypeScript, React, and Tailwind",
	"keywords": [
		"eslint",
		"typescript",
		"react",
		"tailwindcss"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mirite/eslint-config-mirite.git"
	},
	"license": "MIT",
	"author": {
		"name": "Jesse Conner",
		"email": "me@jesseconner.ca"
	},
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"types": "./dist/esm/index.d.ts",
	"files": [
		"dist/**/*"
	],
	"scripts": {
		"build": "yarn clean && tsc -p ./configs/tsconfig.json",
		"check": "tsc --noEmit",
		"clean": "del-cli dist",
		"format": "prettier --write --cache .",
		"lint": "eslint --fix --cache"
	},
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.13",
		"eslint-plugin-perfectionist": "^5.10.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-compiler": "19.1.0-rc.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-tailwindcss": "^4.0.0-beta.0",
		"globals": "^17.7.0",
		"prettier-plugin-jsdoc": "^1.8.1",
		"prettier-plugin-packagejson": "^3.0.2",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"typescript-eslint": "^8.64.0"
	},
	"devDependencies": {
		"@types/eslint-plugin-tailwindcss": "^3.17.0",
		"@types/node": "^26.1.1",
		"del-cli": "^7.0.0",
		"eslint": "^10.7.0",
		"prettier": "^3.9.5",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"eslint": "^10",
		"prettier": "^3",
		"tailwindcss": "^4.2.0"
	},
	"packageManager": "yarn@4.14.1"
}
